# Copy this file to .env and fill in your values.
# Never commit the real .env — it is in .gitignore.

GOOGLE_API_KEY=your_google_api_key_here

# Search area — edit to expand to a different city.
SEARCH_AREA_NAME=Denver, CO
SEARCH_BOUNDS=39.50,-105.20|40.05,-104.45
SEARCH_COMPONENTS=administrative_area:CO|country:US
